{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "transformlab",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-14",
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": true, "not_found_handling": "single-page-application" },
  "vars": { "DEPLOY_ENV": "production", "ACCESS_TEAM_DOMAIN": "", "ACCESS_AUD": "", "ALLOWED_EMAIL": "" },
  "d1_databases": [{ "binding": "DB", "database_name": "transformlab", "database_id": "REPLACE_WITH_D1_DATABASE_ID", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "STORAGE", "bucket_name": "transformlab-files" }]
}
