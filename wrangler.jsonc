{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "transformlab",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-14",
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": true, "not_found_handling": "single-page-application" },
  "d1_databases": [{ "binding": "DB", "database_name": "transformlab", "database_id": "e1ce10d5-35d4-4052-a515-9c4438c7f992", "migrations_dir": "migrations" }]
}
