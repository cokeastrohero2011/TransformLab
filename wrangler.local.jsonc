{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "transformlab-local",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-14",
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": true, "not_found_handling": "single-page-application" },
  "vars": { "DEPLOY_ENV": "development", "DEV_AUTH_BYPASS": "true", "ACCESS_TEAM_DOMAIN": "", "ACCESS_AUD": "", "ALLOWED_EMAIL": "" },
  "d1_databases": [{ "binding": "DB", "database_name": "transformlab", "database_id": "00000000-0000-0000-0000-000000000001", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "STORAGE", "bucket_name": "transformlab-files-local" }]
}
