{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "transformlab-local",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-14",
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": true, "not_found_handling": "single-page-application" },
  "d1_databases": [{ "binding": "DB", "database_name": "transformlab", "database_id": "00000000-0000-0000-0000-000000000001", "migrations_dir": "migrations" }]
}
